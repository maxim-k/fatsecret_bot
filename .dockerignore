# Runtime state. data/ is a mounted volume at run time; baking a copy into the
# image ships the diary, the alias table and every saved photo to wherever the
# image goes.
data/
.env
.env.*

# Never needed in any image. What each stage gets is decided by the COPY lines
# in the Dockerfile, not here: tests and benchmark.py belong in dev, so they
# have to stay in the build context.
.venv/
.git/
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/
.idea/
.DS_Store
