# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Your own numeric Telegram user id. The bot ignores everyone else, so a stranger
# who finds it cannot spend your API credits.
TELEGRAM_OWNER_ID=

# --- Gemini ---
# From aistudio.google.com/apikey. There is a free tier, which rate-limits hard
# enough to matter when running benchmark.py.
GEMINI_API_KEY=
# One model for every photo, chosen by measuring against data/photos/: this read
# 9 of 9 known weights correctly at a 4.7 s median. gemini-3.5-flash-lite is
# faster but repeats the trailing-zero misreads (640 for 64 g); 3.6 and 3.7
# answered 503 on every attempt. Re-run benchmark.py before changing it.
GEMINI_MODEL=gemini-3.5-flash

# --- FatSecret ---
# These are the OAuth 1.0 credentials, labelled "Consumer Key" and "Shared
# Secret" in the console. They are NOT the OAuth 2.0 "Client ID"/"Client
# Secret" pair, which supports only the client_credentials grant and therefore
# only app-level food lookups — it cannot read or write a user's diary at all.
# Picking the wrong pair fails with a bare 400 "Invalid signature".
#
# Remember to whitelist this machine's IP under Manage API Keys, and the VPS IP
# too once deployed — Basic allows 15 individual addresses, no CIDR ranges.
FATSECRET_CONSUMER_KEY=
FATSECRET_CONSUMER_SECRET=
# Obtained once via: uv run python fatsecret.py authorize
FATSECRET_ACCESS_TOKEN=
FATSECRET_ACCESS_SECRET=

# --- Storage ---
# Holds aliases.json, queue.json and log.jsonl. Mount this as a volume in Docker;
# it is the state that must survive a redeploy.
DATA_DIR=./data
