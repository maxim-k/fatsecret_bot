# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Your own numeric Telegram user id. The bot ignores everyone else, so a stranger
# who finds it cannot spend your API credits.
TELEGRAM_OWNER_ID=

# --- Anthropic ---
ANTHROPIC_API_KEY=
# Deliberately the cheap model. Only move up (claude-sonnet-5, then claude-opus-5)
# if it misreads digits on the scale display — check raw_digits on the first
# batch of real photos before deciding.
ANTHROPIC_MODEL=claude-haiku-4-5

# --- FatSecret ---
# From platform.fatsecret.com after registering (free Basic edition).
# Remember to whitelist this machine's IP under Manage API Keys, and the VPS IP
# too once deployed — Basic allows 15 individual addresses, no CIDR ranges.
FATSECRET_CONSUMER_KEY=
FATSECRET_CONSUMER_SECRET=
# Obtained once via: uv run python fatsecret.py authorize
FATSECRET_ACCESS_TOKEN=
FATSECRET_ACCESS_SECRET=

# --- Storage ---
# Holds aliases.json, queue.json and log.jsonl. Mount this as a volume in Docker;
# it is the state that must survive a redeploy.
DATA_DIR=./data
